rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Studio staff who can create/edit workshops and library articles.
    // Membership is just a document's existence — created by hand in the
    // Firebase console (or an admin script), never by a client. See
    // SETUP.md for how to make an account an admin.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Parents can only read/write their own profile and children.
    match /parents/{parentId} {
      allow read, update: if request.auth != null && request.auth.uid == parentId;
      allow create: if request.auth != null && request.auth.uid == parentId;

      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == parentId;
      }
    }

    // Workshop calendar: readable by any signed-in parent. Admins can
    // create/edit/delete workshops; any signed-in parent may additionally
    // update just `bookedCount`, which is how BookingService reserves and
    // releases a spot inside its transaction.
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['bookedCount']));
    }

    // Parent library articles: readable by any signed-in parent,
    // writable only by admins.
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Bookings: a parent can create/read/cancel only their own bookings.
    // bookedCount on the related event is updated in the same
    // transaction, so booking capacity is enforced server-side.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && resource.data.parentUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.parentUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.parentUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);
      allow delete: if false;
    }
  }
}
